# Copie ce fichier en .env puis remplis UNE des deux clés (Gemini ou OpenRouter) et le modèle.
# Ne commite JAMAIS .env (il est dans .gitignore).
GEMINI_API_KEY=ta_cle_ici
# Alternative : une clé OpenRouter (https://openrouter.ai/keys). Laisse GEMINI_API_KEY inchangée.
# OPENROUTER_API_KEY=ta_cle_ici
# Optionnel : force le fournisseur (gemini | openrouter). Par défaut : celui dont la clé est renseignée (Gemini si les deux).
# PROVIDER=openrouter
# Nom du modèle à utiliser, au format du fournisseur (ex. OpenRouter : "fournisseur/modele").
# Les noms changent vite : prends celui indiqué par le formateur ou copie-le depuis la documentation
# (ai.google.dev pour Gemini, openrouter.ai/models pour OpenRouter).
MODEL=nom_du_modele_ici
