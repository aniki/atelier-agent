# Copie ce fichier en .env puis remplis les deux valeurs.
# Ne commite JAMAIS .env (il est dans .gitignore).
GEMINI_API_KEY=ta_cle_ici
# Nom du modèle à utiliser. Les noms changent vite : prends celui indiqué par le formateur
# ou copie-le depuis la documentation Gemini API (ai.google.dev).
MODEL=nom_du_modele_ici
